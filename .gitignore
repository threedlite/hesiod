# Audio, features, model outputs and alignment work stay out of git.
# Everything that regenerates them (scripts, tables, lexicons, reports) is tracked.

# source audio and trimmed corpus
data/iliad/raw/
data/iliad/wavs/
*.wav
*.mp4

# training features and synthesized audio (regenerated by train/prepare_features.py, scripts/synth_hesiod.py)
data/features/
data/synth/

# model runs and checkpoints (176 MB acoustic model, 13 MB recognizer) — keep outside git or in a release
train/runs/
train/checkpoints/

# Montreal Forced Aligner working data, corpus links, TextGrids, trained model
align/mfa_root/
align/corpus/
align/textgrids/
align/*.zip
align/*.log
align/*.nohup.log

# fetched hypotactic material: the zips and CSV export; the parsed tables in data/iliad are tracked
data/scansion/*.zip
data/scansion/iliad_csv/

# derived tables that regenerate in seconds to minutes from tracked inputs
# (scripts/parse_hypotactic.py, greek2ipa/from_spans.py, scripts/qc_iliad_audio.py, ...);
# kept: metadata.csv, exclusions.csv, transcript_overrides.csv, line maps, splits, lexicons, Hesiod tables
data/iliad/hypotactic_lines.csv
data/iliad/hypotactic_scanned_lines.csv
data/iliad/phones.csv
data/iliad/scan.csv
data/iliad/trim_log.csv
data/iliad/alignment_scores.csv
data/iliad/syllable_acoustics.csv
data/iliad/scanner_vs_chamberlain.csv
data/iliad/recognizer_*_per.csv

# the chat transcript this project started from
a.txt

# logs and scratch
*.log
train/*.nohup.log
__pycache__/
.venv/
.DS_Store

# smoke-test scratch (vocoder and pipeline checks)
data/synth_checks/
